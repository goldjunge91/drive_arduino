    +  auto p95_duration = latency_tracker_->getP95Latency();
    +  ASSERT_GT(p95_duration.count(), 0) << "Should have p95 measurement";
    +
    +  double p95_ms = std::chrono::duration<double, std::milli>(p95_duration).count();
    +  EXPECT_LE(p95_ms, 20.0)
